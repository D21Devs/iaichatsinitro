# ──────────────────────────────────────────
#  Forçar HTTPS — Locaweb (proxy SSL)
# ──────────────────────────────────────────
RewriteEngine On

# Na Locaweb o SSL termina no proxy antes do Apache.
# %{HTTPS} nunca fica "on", então usamos o header X-Forwarded-Proto.
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www duplicado (opcional — mantém sem www)
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
